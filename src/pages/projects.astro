---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { projects } from '../data/projects';

const title = 'Projects | Patrick O\'Boyle / oboylenyc';
const description = 'Current public project and future work published from oboyle.nyc.';
---

<BaseLayout title={title} description={description}>
	<section class="page-hero">
		<p class="eyebrow">Projects</p>
		<h1>Public work, starting with one active portfolio-facing repository.</h1>
		<p>
			This section is intentionally small right now. It highlights work I want to keep public and useful, and it will expand as I
			publish more original projects over time.
		</p>
	</section>

	<section>
		<SectionHeading kicker="Repository list" title="Current public project" />
		<div class="post-list">
			{projects.map((project) => (
				<article class="card post-card">
					<div class="meta-row">
						<span>{project.year}</span>
						<span>{project.slug}</span>
					</div>
					<h3>{project.title}</h3>
					<p>{project.description}</p>
					<div class="tag-row">
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
					<a class="link-inline" href={project.repoUrl}>Open repository</a>
				</article>
			))}
		</div>
	</section>
</BaseLayout>
