---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => (import.meta.env.PROD ? data.draft !== true : true));

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Patrick O'Boyle / oboylenyc`} description={post.data.description}>
	<article class="post-shell">
		<header class="post-header">
			<p class="eyebrow">Blog post</p>
			<h1>{post.data.title}</h1>
			<p>{post.data.description}</p>
			<div class="meta-row">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('en-US', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</time>
				{post.data.tags.map((tag: string) => (
					<span>{tag}</span>
				))}
			</div>
		</header>
		<div class="post-body">
			<Content />
		</div>
	</article>
</BaseLayout>
